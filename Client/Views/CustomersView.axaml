<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.CustomersView">
    <!-- Visas när CurrentView är en CustomersViewModel -->
    <StackPanel Spacing="12">
        <TextBlock Text="Customers" FontSize="24" Foreground="{DynamicResource AccentColor}" />
        <TextBlock Text="No customers to display." Foreground="{DynamicResource PrimaryTextColor}" />
    </StackPanel>
</UserControl>
