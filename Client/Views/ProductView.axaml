<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             xmlns:models="using:Client.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.ProductView"
             x:DataType="vm:ProductViewModel">

  <!-- sista raden (*) tar resten av höjden så listan kan scrolla -->
  <Grid Margin="20" RowDefinitions="Auto,Auto,*">
    <TextBlock Grid.Row="0" Classes="h1" Text="{Binding PageTitle}" Margin="0 0 0 12" />

    <!-- rubrikrad, samma kolumner som raderna. De två sista kolumnerna är knapparna. -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource AccentColor}" BorderThickness="0 0 0 2">
      <Grid ColumnDefinitions="200,100,100,150,40,40">
        <Label Grid.Column="0" Content="Name" />
        <Label Grid.Column="1" Content="ItemNumber" />
        <Label Grid.Column="2" Content="Price" />
        <Label Grid.Column="3" Content="SupplierName" />
        <!-- <Label Grid.Column="6" Content="Description" /> -->
      </Grid>
    </Border>

    <!-- en rad per produkt -->
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Products}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="200,100,100,150,40,40">
              <Label Grid.Column="0" Content="{Binding Name}" />
              <Label Grid.Column="1" Content="{Binding ItemNumber}" />
              <Label Grid.Column="2" Content="{Binding Price}" />
              <Label Grid.Column="3" Content="{Binding SupplierName}" />

              <!-- raden är en Product, så knappen går upp till sidans ViewModel ($parent[UserControl])
                   och skickar med artikelnumret som parameter -->
              <Button Grid.Column="4" Command="{Binding $parent[UserControl].DataContext.EditCommand}" CommandParameter="{Binding ItemNumber}" Classes="rowIcon" Content="&#xebc6;" Foreground="Green" />
              <Button Grid.Column="5" Command="{Binding $parent[UserControl].DataContext.DeleteCommand}" CommandParameter="{Binding ItemNumber}" Classes="rowIcon" Content="&#xe4a6;" Foreground="#E5533D" />

              <!-- beskrivningen är bortkommenterad, texten är för lång för tabellen.
              Vill du ha den tillbaka: lägg till en kolumn * sist i båda griddarna och ta bort kommentaren.
              <TextBlock Grid.Column="6"
              Text="{Binding Description}"
              TextWrapping="Wrap"
              MaxLines="3"
              TextTrimming="CharacterEllipsis" />
              -->
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
