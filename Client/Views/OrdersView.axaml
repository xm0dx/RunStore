<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Client.Views.OrdersView">
    <!-- Visas när CurrentView är en OrdersViewModel -->
    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="h1" Text="Orders" />
        <TextBlock Text="No orders to display." Foreground="{DynamicResource PrimaryTextColor}" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
