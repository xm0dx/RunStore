<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Client.ViewModels"
             xmlns:views="using:Client.Views"
             x:Class="Client.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:MainWindowViewModel">
            <views:MainWindow />
        </DataTemplate>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProductViewModel">
            <views:ProductView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Assets/AppStyles.axaml" />
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="PrimaryTextColor" Color="Orange" />
        <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="Black" />
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0% 0%" EndPoint="100% 0%">
            <GradientStop Offset="0" Color="#030664" />
            <GradientStop Offset="1" Color="#35166E" />
        </LinearGradientBrush>
    </Application.Resources>

</Application>
